# Local development configuration
# For deployment, these are set via Terraform / the deploy command.

# Knowledge graph storage.
# `postgres` is the default and the source of truth. `local` reads the YAML in
# app/references/kg/ instead — no longer authoritative, kept because it needs no
# database and is what the migration is verified against.
CAV_KG_BACKEND=postgres
# Matches docker-compose.yml. Point this at Cloud SQL to move the graph there;
# nothing else in the code changes.
CAV_PG_DSN=postgresql://cav:cav@localhost:5432/cav

# Vertex AI Configuration (default)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# Alternatively, for Gemini API via Google AI Studio,
# comment out the three lines above and uncomment:
# GEMINI_API_KEY=your-api-key-here
